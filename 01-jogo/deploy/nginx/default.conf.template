limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=connections:10m;
log_format safe escape=json '{"event":"proxy_request","status":$status,"method":"$request_method","duration":$request_time,"bytes":$body_bytes_sent}';

server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name ${DOMAIN};
    return 308 https://${DOMAIN}$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name ${DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    server_tokens off;
    client_max_body_size 2m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 15s;
    keepalive_timeout 15s;
    limit_conn connections 20;
    limit_req_status 429;
    limit_conn_status 429;
    access_log /dev/stdout safe;
    error_log /dev/stderr warn;
    error_page 429 = @rate_limited;
    error_page 502 504 = @unavailable;
    add_header Strict-Transport-Security 'max-age=31536000' always;

    location @rate_limited {
        default_type application/json;
        add_header Retry-After 60 always;
        return 429 '{"error":{"status":429,"message":"Limite de requisições excedido."}}';
    }
    location @unavailable {
        default_type application/json;
        add_header Retry-After 5 always;
        return 503 '{"error":{"status":503,"message":"Serviço temporariamente indisponível."}}';
    }
    location /internal/ { return 404; }
    location ~ ^/(api/v1/auth/login|autenticar)$ {
        limit_req zone=login burst=5 nodelay;
        include /etc/nginx/proxy-common.conf;
    }
    location / {
        limit_req zone=general burst=20 nodelay;
        include /etc/nginx/proxy-common.conf;
    }
}
